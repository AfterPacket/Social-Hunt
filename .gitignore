.venv/
.venv-iopaint/
.venv-deepmosaic/
__pycache__/
*.pyc
*.log
.env

# Third-party AI worker repos — cloned on demand by scripts/setup-ai.ps1
# or `git submodule update --init DeepMosaics`. Do not commit their contents.
DeepMosaics/

# Local Data & Persistence - Keep structure but ignore contents
data/*
!data/.gitkeep
!data/jobs/
data/jobs/*
!data/jobs/.gitkeep

temp/*
!temp/.gitkeep

web/temp_uploads/*
!web/temp_uploads/.gitkeep

# Ignore the real demasking code backup
web/views/demask.html.real

# Local backups
_backup_*/
data/settings.json

# Docker SSL artifacts
docker/ssl/ssl.env
docker/ssl/nginx-ssl.conf
docker/ssl/certbot/*
!docker/ssl/certbot/.gitkeep
docker/ssl/certs/*
!docker/ssl/certs/.gitkeep
